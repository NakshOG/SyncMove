FROM node:22-bookworm-slim

WORKDIR /app

# Mediasoup uses a native worker. Debian/glibc allows its prebuilt worker to
# install reliably; the toolchain remains available for a source build fallback.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip make g++ pkg-config cmake \
  && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY server ./server

WORKDIR /app/server
ENV NODE_ENV=production
ENV MEDIASOUP_PORT=3333
EXPOSE 3333
EXPOSE 40000-40099/udp

CMD ["node", "--import", "tsx", "mediasoup-server.ts"]
